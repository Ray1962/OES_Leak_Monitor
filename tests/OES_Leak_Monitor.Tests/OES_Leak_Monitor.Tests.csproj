<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0-windows and x64 because the project under test is: the app is WPF and
         x64-only, and a test project on a different target or platform cannot reference it. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- xunit v2 has no dynamic skip. The recorded-run tests need one: they depend on a
         measurement file too large to commit, and a test that quietly passes when it tested
         nothing is worse than one that says it was skipped. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OES_Leak_Monitor\OES_Leak_Monitor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Aqst.OesApp.Core" />
    <Using Include="Aqst.OesApp.Wpf" />
  </ItemGroup>

</Project>
