<UserControl x:Class="OES_Leak_Monitor.SecsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OES_Leak_Monitor">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="#445"/>
        </Style>
        <Style x:Key="PathText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#667"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <DockPanel Background="#F4F6FA">

        <!-- Status. Visible to every role: "is the tool talking to the MES?" is a question an
             Operator is asked, and the answer must not need a sign-in. -->
        <Border DockPanel.Dock="Top" Background="White"
                BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="10,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Background="{Binding StateBrush}" CornerRadius="3" Padding="10,3"
                            MinWidth="130" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding StateText}" Foreground="White"
                                   FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding StatusDetail}" VerticalAlignment="Center"
                               Foreground="#334" TextWrapping="Wrap" MaxWidth="700"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Control state:" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding ControlStateText}" VerticalAlignment="Center"
                               Foreground="#334" Margin="0,0,16,0"
                               ToolTip="SEMI E30 control state. Only ONLINE-REMOTE accepts host commands — including TOOL_EVENT, the main tool's process events the EAP forwards. In any other state it is answered HCACK 2."/>
                    <TextBlock Text="{Binding ChamberName}" VerticalAlignment="Center" Foreground="#334"/>
                </StackPanel>

                <TextBlock Text="{Binding ReportingSummary}" Margin="0,6,0,0"
                           Foreground="#334" TextWrapping="Wrap"
                           ToolTip="Switching reporting off does not hide anything: the state still reaches this app's own log and any host status query. It only stops the equipment volunteering it."/>

                <!-- Tool events: which process window the leak monitor is judging in. Ungated —
                     "does the OES know what the tool is running?" is an Operator question too. -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                            ToolTip="From the main tool's process events the EAP forwards as S2F41 TOOL_EVENT (VID 030–032). The CEID table is below.">
                    <TextBlock Text="{Binding ToolContextText}" Foreground="#334" Margin="0,0,16,0"
                               AutomationProperties.Name="Tool event context" TextWrapping="Wrap" MaxWidth="760"/>
                    <TextBlock Text="{Binding ToolLastEventText}" Foreground="#334" Margin="0,0,16,0"
                               AutomationProperties.Name="Last tool event"/>
                    <TextBlock Text="{Binding ToolEventCountText}" Foreground="#334"
                               AutomationProperties.Name="Tool event count"/>
                </StackPanel>

                <!-- The EAP's plain-TCP event link: the same events for a site whose SECS host is
                     the FDC. Ungated status; orange once a silence has made the window unknown. -->
                <StackPanel Margin="0,4,0,0"
                            ToolTip="The OES connects to the EAP and receives the main tool's events (EVT) and a 30 s heartbeat (HB) over plain TCP. Every line is in Log\eap_yyyyMMdd.log.">
                    <TextBlock Text="{Binding EapLinkText}" Foreground="{Binding EapLinkBrush}" FontWeight="SemiBold"
                               AutomationProperties.Name="EAP link" TextWrapping="Wrap" MaxWidth="900"
                               HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding EapDetailText}" Foreground="{Binding EapLinkBrush}"
                               AutomationProperties.Name="EAP link detail" TextWrapping="Wrap" MaxWidth="900"
                               HorizontalAlignment="Left"/>
                </StackPanel>

                <TextBlock Text="{Binding IdExample}" Margin="0,4,0,0" Foreground="#777"
                           TextWrapping="Wrap"
                           ToolTip="Every id is derived from the chamber code. Check these against the host's configuration — a mismatch here is the usual reason a host connects and then reads nothing."/>
            </StackPanel>
        </Border>

        <!-- Settings. Engineer+ only; the tab itself is open to all, so the controls carry the gate. -->
        <Border DockPanel.Dock="Top" Background="#FAFAFA"
                BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="10,8"
                IsEnabled="{Binding CanEdit}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <CheckBox Content="Enable SECS" IsChecked="{Binding Enabled}"
                              VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="Bold"
                              ToolTip="Master switch. Off means no port is opened at all."/>
                    <CheckBox Content="Report alarms (S5F1)" IsChecked="{Binding ReportAlarms}"
                              VerticalAlignment="Center" Margin="0,0,16,0"
                              ToolTip="Leak warning / leak alarm and equipment faults. Off while commissioning, so a test run does not file alarms in the fab's MES."/>
                    <CheckBox Content="Report events (S6F11)" IsChecked="{Binding ReportEvents}"
                              VerticalAlignment="Center" Margin="0,0,16,0"
                              ToolTip="Acquisition started / stopped and alarm acknowledged."/>
                    <CheckBox Content="Report test / replay data too" IsChecked="{Binding ReportInTestMode}"
                              VerticalAlignment="Center"
                              ToolTip="Off by default. Synthetic and replayed frames are not measurements, and an alarm arriving at the host carries no marking that says so. Switch it on deliberately, to validate the alarm path against a recording of a real leak. VID 016 reports the truth either way."/>
                </StackPanel>

                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                        <TextBlock Text="Chamber:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Chambers}" DisplayMemberPath="Display"
                                  SelectedValuePath="Code" SelectedValue="{Binding ChamberCode}"
                                  Width="190" VerticalAlignment="Center"
                                  ToolTip="Which chamber this OES watches. Every SVID, ALID and CEID is derived from it — this is the one number that must match what the host was told."/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                        <TextBlock Text="Address:" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Width="120" VerticalAlignment="Center" Margin="0,0,8,0"
                                 ToolTip="0.0.0.0 listens on every adapter; 127.0.0.1 for a bench test against Test_SECS on this machine."/>
                        <TextBlock Text="Port:" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                 Width="60" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Device ID:" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding DeviceId, UpdateSourceTrigger=PropertyChanged}"
                                 Width="50" VerticalAlignment="Center"
                                 ToolTip="Must match the host. HSMS does not check it during the handshake, so a mismatch shows up later as data messages being rejected with S9F1."/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                        <CheckBox Content="Connect out (active)" IsChecked="{Binding IsActive}"
                                  VerticalAlignment="Center"
                                  ToolTip="Equipment is normally passive: it listens and the host connects to it. Tick this only if the host expects the equipment to dial out."/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                        <TextBlock Text="Model (MDLN):" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}"
                                 Width="90" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Revision:" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding SoftwareRevision, UpdateSourceTrigger=PropertyChanged}"
                                 Width="70" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,20,8"
                                ToolTip="HSMS timeouts in seconds (specification §2). T3 is how long a reply is waited for.">
                        <TextBlock Text="T3:" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding T3}" Width="42" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="T5:" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding T5}" Width="42" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="T6:" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding T6}" Width="42" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="T7:" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding T7}" Width="42" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="T8:" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding T8}" Width="42" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,20,8">
                        <TextBlock Text="Keep traffic logs (days):" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding LogRetentionDays}" Width="46" VerticalAlignment="Center"
                                 ToolTip="Day files older than this are deleted. 0 keeps them for ever. Acceptance usually asks for this log, so keep at least a few days."/>
                    </StackPanel>
                </WrapPanel>

                <!-- Tool events. Two kinds of field, labelled as such: the switch (with the CEID
                     table) is staged — adopted at the next acquisition start, because the table
                     names the classes the ratios refer to — while the window limit and the
                     test-mode switch apply on save. -->
                <Border BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="0,6,0,2" Margin="0,2,0,4">
                    <WrapPanel>
                        <TextBlock Text="Tool events (S2F41 TOOL_EVENT):" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,12,6"/>
                        <CheckBox Content="Use tool events — takes effect at next acquisition start"
                                  IsChecked="{Binding ToolEventsEnabled}"
                                  AutomationProperties.Name="Use tool events"
                                  VerticalAlignment="Center" Margin="0,0,20,6"
                                  ToolTip="The main tool's process events, forwarded by the EAP, decide which class-scoped ratios judge. Staged with the CEID table: saved now, applied when acquisition next starts (Stop, then Start)."/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,6">
                            <TextBlock Text="Max window (s) — applies on save:" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ToolMaxWindowSeconds}" Width="60" VerticalAlignment="Center"
                                     AutomationProperties.Name="Max window seconds"
                                     ToolTip="A window open longer than this lost its End: it closes and ratios are judged as without tool events until the next edge. 10–86400 s; a process A step is 38–63 s."/>
                        </StackPanel>
                        <CheckBox Content="Apply tool events in test mode — applies on save"
                                  IsChecked="{Binding ToolApplyInTestMode}"
                                  AutomationProperties.Name="Apply tool events in test mode"
                                  VerticalAlignment="Center" Margin="0,0,0,6"
                                  ToolTip="Off by default: a synthetic spectrum is not the chamber. On, the tool's window is applied to test-mode spectra, so the windows can be exercised on a machine with no spectrometer. Never applies during a replay."/>
                    </WrapPanel>
                </Border>

                <!-- EAP TCP link. All four apply on save: a transport names no class. -->
                <Border BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="0,6,0,2" Margin="0,2,0,4">
                    <WrapPanel>
                        <TextBlock Text="EAP link (TCP) — applies on save:" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,12,6"/>
                        <CheckBox Content="Connect to the EAP"
                                  IsChecked="{Binding EapEnabled}"
                                  AutomationProperties.Name="Connect to the EAP"
                                  VerticalAlignment="Center" Margin="0,0,20,6"
                                  ToolTip="The OES connects to the address the EAP listens on and receives the main tool's events there. What they do is still decided by 'Use tool events' and the CEID table."/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,6">
                            <TextBlock Text="EAP address:" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding EapHost}" Width="120" VerticalAlignment="Center"
                                     AutomationProperties.Name="EAP address"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,6">
                            <TextBlock Text="Port:" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding EapPort}" Width="60" VerticalAlignment="Center"
                                     AutomationProperties.Name="EAP port"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Heartbeat timeout (s):" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding EapHeartbeatTimeoutSeconds}" Width="60" VerticalAlignment="Center"
                                     AutomationProperties.Name="EAP heartbeat timeout seconds"
                                     ToolTip="With no line at all from the EAP for this long, the process window is set to unknown and ratios are judged as without tool events. A dropped connection alone does not do this. 35–600 s; the EAP sends a heartbeat every 30 s."/>
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="Save &amp; apply" Command="{Binding SaveCommand}"
                            Padding="14,4" MinWidth="110" Margin="0,0,8,0" FontWeight="Bold"
                            ToolTip="Writes these settings to settings.json and rebuilds the interface. Nothing here takes effect as it is typed."/>
                    <Button Content="Restart interface" Command="{Binding RestartCommand}"
                            Padding="14,4" MinWidth="130" Margin="0,0,16,0"
                            ToolTip="Re-reads the profile file and starts over — what you press after editing the profile JSON by hand."/>
                    <TextBlock VerticalAlignment="Center" Foreground="#B8860B" FontWeight="SemiBold"
                               Text="Unsaved changes">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- The CEID table, read-only and ungated: everyone may see what the tool's events mean,
             and a disabled grid would grey it out for exactly the people reading it. -->
        <Border DockPanel.Dock="Top" Background="#FAFAFA"
                BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="10,6">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Tool event CEID table (as saved):" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="Edited in settings.json (secs.toolEvents.mappings); takes effect at the next acquisition start."
                               Foreground="#777" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding ToolTablePendingText}" Foreground="#B8860B" FontWeight="SemiBold"
                           Margin="0,4,0,0" TextWrapping="Wrap"
                           AutomationProperties.Name="Tool table pending"
                           Visibility="{Binding ToolTablePending, Converter={StaticResource BoolToVis}}"/>
                <DataGrid ItemsSource="{Binding ToolEventMappings}" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False"
                          CanUserDeleteRows="False" CanUserReorderColumns="False"
                          GridLinesVisibility="Horizontal" Background="White"
                          MaxHeight="150" Margin="0,4,0,0"
                          AutomationProperties.Name="Tool event CEID table">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CEID" Binding="{Binding Ceid}" Width="110"/>
                        <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="100"/>
                        <DataGridTextColumn Header="Edge" Binding="{Binding Edge}" Width="60"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="320"/>
                        <DataGridTextColumn Header="Plasma threshold" Binding="{Binding PlasmaThreshold}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- Where the files are. Field staff have to be able to find these without a developer. -->
        <Border DockPanel.Dock="Top" Background="#FAFAFA"
                BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="10,6">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Profile (edit this):" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding ProfileTemplatePath}" Style="{StaticResource PathText}"
                               MaxWidth="620" ToolTip="{Binding ProfileTemplatePath}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="In use (generated):" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding EffectiveProfilePath}" Style="{StaticResource PathText}"
                               MaxWidth="620" ToolTip="Rewritten from the profile on every start with the chamber code stamped in. Editing this copy achieves nothing — edit the one above and press Restart interface."/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="Traffic log:" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding LogFilePath}" Style="{StaticResource PathText}"
                               MaxWidth="620" ToolTip="{Binding LogFilePath}"/>
                </StackPanel>
                <!-- A profile is never overwritten, so rows a later build adds reach this machine
                     only through here. Engineer+ (the command checks CanEdit). -->
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Add missing rows" Command="{Binding AddMissingRowsCommand}"
                            Padding="12,3" MinWidth="130" Margin="0,0,12,0" VerticalAlignment="Top"
                            AutomationProperties.Name="Add missing rows"
                            ToolTip="Appends to the profile above the status variables, events, alarms and remote commands this build ships and the file lacks. Rows already there are not touched, renumbered or renamed ones included; a row whose number is already taken is refused and listed. The profile is backed up first ({profile}.bak-yyyyMMddHHmmss). Takes effect the next time the interface starts. Engineer and above."/>
                    <StackPanel>
                        <TextBlock Text="{Binding MissingRowsText}" TextWrapping="Wrap" MaxWidth="620"
                                   Foreground="#555" AutomationProperties.Name="Missing rows"/>
                        <TextBlock Text="{Binding AddMissingRowsResultText}" TextWrapping="Wrap" MaxWidth="620"
                                   Foreground="#B8860B" FontWeight="SemiBold" Margin="0,2,0,0"
                                   AutomationProperties.Name="Add missing rows result"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Live traffic -->
        <Border DockPanel.Dock="Top" Background="#FAFAFA" Padding="10,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Traffic" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Content="Clear" Command="{Binding ClearTrafficCommand}" Padding="10,2"
                        ToolTip="Clears the on-screen list only. The file keeps everything."/>
                <TextBlock Text="every message in and out, newest last" VerticalAlignment="Center"
                           Foreground="#888" Margin="12,0,0,0"/>
            </StackPanel>
        </Border>

        <ListBox x:Name="TrafficList" ItemsSource="{Binding Traffic}"
                 FontFamily="Consolas" FontSize="11" Background="White"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="2,0"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </DockPanel>
</UserControl>
