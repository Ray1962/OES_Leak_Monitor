<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RootNamespace>OES_Leak_Monitor</RootNamespace>
    <AssemblyName>OES_Leak_Monitor</AssemblyName>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aqst.OesApp.Core" Version="0.1.3" />
    <PackageReference Include="Aqst.OesApp.Wpf"  Version="0.1.7" />
    <PackageReference Include="Aqst.OesSpectrometer" Version="0.4.6" />
    <PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Aqst.OesApp.Core" />
    <Using Include="Aqst.OesApp.Wpf" />
  </ItemGroup>

  <!--
    Aqst.OesSpectrometer ships UserApplication.dll / SiUSBXp.dll / libsodium.dll under
    runtimes\win-x64\native\, but DllResolver only searches the app base directory.
    Flatten the native DLLs into the output root so the resolver can find them.
  -->
  <Target Name="FlattenOesNativeDlls" AfterTargets="Build;Publish">
    <ItemGroup>
      <_OesNative Include="$(OutDir)runtimes\win-x64\native\UserApplication.dll" />
      <_OesNative Include="$(OutDir)runtimes\win-x64\native\SiUSBXp.dll" />
      <_OesNative Include="$(OutDir)runtimes\win-x64\native\libsodium.dll" />
      <_OesNativePub Include="$(PublishDir)runtimes\win-x64\native\UserApplication.dll" Condition="'$(PublishDir)' != ''" />
      <_OesNativePub Include="$(PublishDir)runtimes\win-x64\native\SiUSBXp.dll" Condition="'$(PublishDir)' != ''" />
      <_OesNativePub Include="$(PublishDir)runtimes\win-x64\native\libsodium.dll" Condition="'$(PublishDir)' != ''" />
    </ItemGroup>
    <Copy SourceFiles="@(_OesNative)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('%(_OesNative.FullPath)')" />
    <Copy SourceFiles="@(_OesNativePub)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('%(_OesNativePub.FullPath)')" />
  </Target>

  <!--
    Publish into an empty folder, always.

    An incremental `dotnet publish` (nothing changed since the last one) leaves
    the .exe but strips every loose native DLL from the publish folder. The
    result still launches and looks healthy, then silently falls back to test
    mode on the target PC because DllResolver finds no UserApplication.dll —
    the worst failure mode this app has. Emptying the folder first forces the
    full copy every time; the few seconds it costs are worth not shipping that.

    Only ever cleans a folder under the project's own bin\. A `dotnet publish
    -o <somewhere>` pointing outside it is left alone and warned about, since
    that path may be a real directory with other content in it.
  -->
  <!-- PrepareForPublish, not Publish: the publish pipeline copies its files inside
       targets that Publish depends on, so BeforeTargets="Publish" runs *after* the
       copy and would wipe the folder it was meant to protect. -->
  <Target Name="EmptyPublishDirBeforePublish" BeforeTargets="PrepareForPublish" Condition="'$(PublishDir)' != ''">
    <PropertyGroup>
      <_PubFull>$([System.IO.Path]::GetFullPath('$(PublishDir)'))</_PubFull>
      <_BinFull>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\bin'))</_BinFull>
      <_PubLower>$(_PubFull.ToLowerInvariant())</_PubLower>
      <_BinLower>$(_BinFull.ToLowerInvariant())</_BinLower>
      <_PubUnderBin>$(_PubLower.StartsWith('$(_BinLower)'))</_PubUnderBin>
    </PropertyGroup>
    <RemoveDir Directories="$(_PubFull)"
               Condition="'$(_PubUnderBin)' == 'true' And Exists('$(_PubFull)')" />
    <Warning Text="Publish folder $(_PubFull) is outside the project's bin\, so it was not emptied. Publishing into a folder that already holds a previous publish can silently drop the loose native DLLs — empty it yourself first."
             Condition="'$(_PubUnderBin)' != 'true'" />
  </Target>

  <!--
    The publish folder is what actually gets handed to a production PC, so the
    operator-facing HTML docs ship inside it rather than living only in the repo.
    Publish only, not Build — a dev output folder doesn't need them.

    Warn rather than fail if one is missing: an absent doc should not block a
    build, but it must not pass silently either, or a delivery folder quietly
    goes out with no manual in it. Both the Warning and the Copy batch over the
    item, so each missing file warns on its own and the rest still ship.
  -->
  <Target Name="CopyOperatorDocs" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <_OperatorDoc Include="$(MSBuildProjectDirectory)\..\..\docs\user-manual-zh-TW.html" />
      <_OperatorDoc Include="$(MSBuildProjectDirectory)\..\..\docs\daily-inspection-plan-zh-TW.html" />
    </ItemGroup>
    <Warning Text="Operator document not found at %(_OperatorDoc.FullPath) — the publish folder will ship without it. Regenerate the HTML from its Markdown source with tools/md2html.py (see CLAUDE.md &gt; Documentation)."
             Condition="!Exists('%(_OperatorDoc.FullPath)')" />
    <Copy SourceFiles="@(_OperatorDoc)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true"
          Condition="Exists('%(_OperatorDoc.FullPath)')" />
  </Target>

</Project>
