<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RootNamespace>OES_Leak_Monitor</RootNamespace>
    <AssemblyName>OES_Leak_Monitor</AssemblyName>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aqst.OesApp.Core" Version="0.1.7" />
    <PackageReference Include="Aqst.OesApp.Wpf"  Version="0.1.13" />
    <PackageReference Include="Aqst.OesSpectrometer" Version="0.4.6" />
    <PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
    <!-- SECS/GEM equipment side. Secs4Net is referenced directly too, for the
         SecsGemOptions / ConnectionState types the SECS tab binds to. -->
    <PackageReference Include="Aqusen.Secs" Version="0.6.0" />
    <PackageReference Include="Secs4Net" Version="2.4.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Aqst.OesApp.Core" />
    <Using Include="Aqst.OesApp.Wpf" />
  </ItemGroup>

  <!--
    Aqst.OesSpectrometer ships UserApplication.dll / SiUSBXp.dll / libsodium.dll under
    runtimes\win-x64\native\, but DllResolver only searches the app base directory.
    Flatten the native DLLs into the output root so the resolver can find them.
  -->
  <Target Name="FlattenOesNativeDlls" AfterTargets="Build;Publish">
    <ItemGroup>
      <_OesNative Include="$(OutDir)runtimes\win-x64\native\UserApplication.dll" />
      <_OesNative Include="$(OutDir)runtimes\win-x64\native\SiUSBXp.dll" />
      <_OesNative Include="$(OutDir)runtimes\win-x64\native\libsodium.dll" />
      <_OesNativePub Include="$(PublishDir)runtimes\win-x64\native\UserApplication.dll" Condition="'$(PublishDir)' != ''" />
      <_OesNativePub Include="$(PublishDir)runtimes\win-x64\native\SiUSBXp.dll" Condition="'$(PublishDir)' != ''" />
      <_OesNativePub Include="$(PublishDir)runtimes\win-x64\native\libsodium.dll" Condition="'$(PublishDir)' != ''" />
    </ItemGroup>
    <Copy SourceFiles="@(_OesNative)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('%(_OesNative.FullPath)')" />
    <Copy SourceFiles="@(_OesNativePub)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('%(_OesNativePub.FullPath)')" />
  </Target>

  <!--
    Ship the Visual C++ runtime app-local.

    UserApplication.dll statically imports libsodium.dll, which imports
    VCRUNTIME140.dll. On a PC that has never had the Visual C++ 2015-2022 x64
    redistributable installed, LoadLibrary fails with Win32 126 before a single
    device is enumerated, and the SDK turns that into a silent test-mode
    fallback: the app reports "Connected", writes synthetic spectra into the
    real data folder, and logs nothing at all about why. Measured on a fab PC
    on 2026-08-17 — the whole delivery folder was present and correct, the
    driver was fine, the vendor software connected, and this was the difference.

    Windows resolves a dependency from the executable's own folder before the
    system directories, so three DLLs next to the .exe remove the prerequisite
    entirely. vcruntime140_cor3.dll is WPF's renamed private copy and does NOT
    satisfy an import of VCRUNTIME140.dll — it is not a substitute. All three
    are needed together: msvcp140.dll imports VCRUNTIME140_1.dll.

    Source: an explicit VcRuntimeSourceDir if the build sets one, else the VS
    C++ redist folder when building from a developer prompt, else System32 —
    the same binaries the redistributable installs. Warn rather than fail, like
    CopyOperatorDocs; publish.cmd re-checks the folder and refuses to ship an
    incomplete one.
  -->
  <PropertyGroup>
    <VcRuntimeSourceDir Condition="'$(VcRuntimeSourceDir)' == '' And '$(VCToolsRedistDir)' != '' And Exists('$(VCToolsRedistDir)x64\Microsoft.VC143.CRT\vcruntime140.dll')">$(VCToolsRedistDir)x64\Microsoft.VC143.CRT\</VcRuntimeSourceDir>
    <VcRuntimeSourceDir Condition="'$(VcRuntimeSourceDir)' == ''">$(SystemRoot)\System32\</VcRuntimeSourceDir>
  </PropertyGroup>

  <Target Name="CopyVcRuntime" AfterTargets="Build;Publish">
    <ItemGroup>
      <_VcRuntime Include="$(VcRuntimeSourceDir)vcruntime140.dll" />
      <_VcRuntime Include="$(VcRuntimeSourceDir)vcruntime140_1.dll" />
      <_VcRuntime Include="$(VcRuntimeSourceDir)msvcp140.dll" />
    </ItemGroup>
    <Warning Text="Visual C++ runtime not found at %(_VcRuntime.FullPath) — the output folder will ship without it, and the app will fall back to test mode (silently) on any PC without the VC++ 2015-2022 x64 redistributable installed. Install that redistributable on this build machine, or point -p:VcRuntimeSourceDir=&lt;folder&gt; at a copy."
             Condition="!Exists('%(_VcRuntime.FullPath)')" />
    <Copy SourceFiles="@(_VcRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"
          Condition="Exists('%(_VcRuntime.FullPath)')" />
    <Copy SourceFiles="@(_VcRuntime)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true"
          Condition="'$(PublishDir)' != '' And Exists('%(_VcRuntime.FullPath)')" />
  </Target>

  <!--
    Publish into an empty folder, always.

    An incremental `dotnet publish` (nothing changed since the last one) leaves
    the .exe but strips every loose native DLL from the publish folder. The
    result still launches and looks healthy, then silently falls back to test
    mode on the target PC because DllResolver finds no UserApplication.dll —
    the worst failure mode this app has. Emptying the folder first forces the
    full copy every time; the few seconds it costs are worth not shipping that.

    Only ever cleans a folder under the project's own bin\. A `dotnet publish
    -o <somewhere>` pointing outside it is left alone and warned about, since
    that path may be a real directory with other content in it.
  -->
  <!-- PrepareForPublish, not Publish: the publish pipeline copies its files inside
       targets that Publish depends on, so BeforeTargets="Publish" runs *after* the
       copy and would wipe the folder it was meant to protect. -->
  <Target Name="EmptyPublishDirBeforePublish" BeforeTargets="PrepareForPublish" Condition="'$(PublishDir)' != ''">
    <PropertyGroup>
      <_PubFull>$([System.IO.Path]::GetFullPath('$(PublishDir)'))</_PubFull>
      <_BinFull>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\bin'))</_BinFull>
      <_PubLower>$(_PubFull.ToLowerInvariant())</_PubLower>
      <_BinLower>$(_BinFull.ToLowerInvariant())</_BinLower>
      <_PubUnderBin>$(_PubLower.StartsWith('$(_BinLower)'))</_PubUnderBin>
    </PropertyGroup>
    <RemoveDir Directories="$(_PubFull)"
               Condition="'$(_PubUnderBin)' == 'true' And Exists('$(_PubFull)')" />
    <Warning Text="Publish folder $(_PubFull) is outside the project's bin\, so it was not emptied. Publishing into a folder that already holds a previous publish can silently drop the loose native DLLs — empty it yourself first."
             Condition="'$(_PubUnderBin)' != 'true'" />
  </Target>

  <!--
    The publish folder is what actually gets handed to a production PC, so the
    operator-facing HTML docs ship inside it rather than living only in the repo.
    Publish only, not Build — a dev output folder doesn't need them.

    Warn rather than fail if one is missing: an absent doc should not block a
    build, but it must not pass silently either, or a delivery folder quietly
    goes out with no manual in it. Both the Warning and the Copy batch over the
    item, so each missing file warns on its own and the rest still ship.
  -->
  <Target Name="CopyOperatorDocs" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <_OperatorDoc Include="$(MSBuildProjectDirectory)\..\..\docs\user-manual-zh-TW.html" />
      <_OperatorDoc Include="$(MSBuildProjectDirectory)\..\..\docs\daily-inspection-plan-zh-TW.html" />
      <_OperatorDoc Include="$(MSBuildProjectDirectory)\..\..\docs\secs-operation-sop-zh-TW.html" />
    </ItemGroup>
    <Warning Text="Operator document not found at %(_OperatorDoc.FullPath) — the publish folder will ship without it. Regenerate the HTML from its Markdown source with tools/md2html.py (see CLAUDE.md &gt; Documentation)."
             Condition="!Exists('%(_OperatorDoc.FullPath)')" />
    <Copy SourceFiles="@(_OperatorDoc)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true"
          Condition="Exists('%(_OperatorDoc.FullPath)')" />
  </Target>

  <!--
    The connect diagnostic travels with the app, for the same reason the manual
    does: it has to be run on the machine that is failing, in the app's own
    folder, by whoever is standing in front of it — and that is never a machine
    with the repo on it. The manual's §9.1 tells the operator to double-click
    check-oes-connect.cmd in this folder, so it has to be here.

    Publish only, and warn rather than fail, exactly like CopyOperatorDocs.
  -->
  <Target Name="CopyConnectDiagnostic" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <_ShippedTool Include="$(MSBuildProjectDirectory)\..\..\tools\check-oes-connect.ps1" />
      <_ShippedTool Include="$(MSBuildProjectDirectory)\..\..\tools\check-oes-connect.cmd" />
    </ItemGroup>
    <Warning Text="Connect diagnostic not found at %(_ShippedTool.FullPath) — the publish folder will ship without it, and the manual's §9.1 points operators at a file that is not there."
             Condition="!Exists('%(_ShippedTool.FullPath)')" />
    <Copy SourceFiles="@(_ShippedTool)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true"
          Condition="Exists('%(_ShippedTool.FullPath)')" />
  </Target>

</Project>
