<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RootNamespace>OES_Leak_Monitor</RootNamespace>
    <AssemblyName>OES_Leak_Monitor</AssemblyName>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aqst.OesApp.Core" Version="0.1.3" />
    <PackageReference Include="Aqst.OesApp.Wpf"  Version="0.1.7" />
    <PackageReference Include="Aqst.OesSpectrometer" Version="0.4.6" />
    <PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Aqst.OesApp.Core" />
    <Using Include="Aqst.OesApp.Wpf" />
  </ItemGroup>

  <!--
    Aqst.OesSpectrometer ships UserApplication.dll / SiUSBXp.dll / libsodium.dll under
    runtimes\win-x64\native\, but DllResolver only searches the app base directory.
    Flatten the native DLLs into the output root so the resolver can find them.
  -->
  <Target Name="FlattenOesNativeDlls" AfterTargets="Build;Publish">
    <ItemGroup>
      <_OesNative Include="$(OutDir)runtimes\win-x64\native\UserApplication.dll" />
      <_OesNative Include="$(OutDir)runtimes\win-x64\native\SiUSBXp.dll" />
      <_OesNative Include="$(OutDir)runtimes\win-x64\native\libsodium.dll" />
      <_OesNativePub Include="$(PublishDir)runtimes\win-x64\native\UserApplication.dll" Condition="'$(PublishDir)' != ''" />
      <_OesNativePub Include="$(PublishDir)runtimes\win-x64\native\SiUSBXp.dll" Condition="'$(PublishDir)' != ''" />
      <_OesNativePub Include="$(PublishDir)runtimes\win-x64\native\libsodium.dll" Condition="'$(PublishDir)' != ''" />
    </ItemGroup>
    <Copy SourceFiles="@(_OesNative)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('%(_OesNative.FullPath)')" />
    <Copy SourceFiles="@(_OesNativePub)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('%(_OesNativePub.FullPath)')" />
  </Target>

  <!--
    The publish folder is what actually gets handed to a production PC, so the
    operator manual ships inside it rather than living only in the repo. Publish
    only, not Build — a dev output folder doesn't need it.

    Warn rather than fail if it is missing: an absent doc should not block a
    build, but it must not pass silently either, or a delivery folder quietly
    goes out with no manual in it.
  -->
  <Target Name="CopyOperatorManual" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <PropertyGroup>
      <_ManualPath>$(MSBuildProjectDirectory)\..\..\docs\user-manual-zh-TW.html</_ManualPath>
    </PropertyGroup>
    <Warning Text="Operator manual not found at $(_ManualPath) — the publish folder will ship without it. Regenerate it with: python3 tools/md2html.py docs/user-manual-zh-TW.md docs/user-manual-zh-TW.html &quot;OES Leak Monitor 操作手冊&quot;"
             Condition="!Exists('$(_ManualPath)')" />
    <Copy SourceFiles="$(_ManualPath)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true"
          Condition="Exists('$(_ManualPath)')" />
  </Target>

</Project>
