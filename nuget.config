<configuration>
  <packageSources>
    <clear />
    <add key="local-aqst" value="C:\Users\infor\source\repos\Ray1962\LocalPackages" />
    <!-- Aqusen.Secs is packed into its own repo's nupkgs\ and also copied into
         local-aqst above. Both on purpose: local-aqst is what makes a build
