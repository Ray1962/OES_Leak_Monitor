         what picks up a new pack during development without a copy step. -->
    <add key="aqusen" value="C:\Users\infor\source\repos\Test_SECS\nupkgs" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
